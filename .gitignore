# Python
__pycache__/
*.py[cod]

# Derived artefacts — regenerate with `python texas-senate-2026/_staging/_lead_build_site.py`
texas-senate-2026/_staging/*.png
texas-senate-2026/_staging/checks/
texas-senate-2026/_staging/discovery_result.json

# Intermediate working files. The deliverables do not depend on them; see README §6 / §6.1.
texas-senate-2026/_staging/*.tsv
texas-senate-2026/_staging/*.ps1
texas-senate-2026/_staging/_commons_cache.json
texas-senate-2026/_staging/_headers_dump.txt
texas-senate-2026/_staging/[A-E]_sources.csv

# OS clutter
.DS_Store
Thumbs.db
desktop.ini

# Video pipeline binaries: ~490 MB of source video + ~47 MB ONNX weights.
# They are NOT needed to read or serve the archive; restore them with
#   python texas-senate-2026/_staging/vision/fetch_models.py
#   python texas-senate-2026/_staging/vision/download_videos.py
texas-senate-2026/_staging/vision/raw/
texas-senate-2026/_staging/vision/models/

# Per-crop face cache (~90 MB, 8k files). Regenerate with extract_faces.py.
# The identified CSVs (manifest.csv, identity.csv) ARE tracked.
texas-senate-2026/_staging/vision/out/*/faces/
texas-senate-2026/_staging/vision/out/*/frames/
texas-senate-2026/_staging/vision/out/*/sheet_*.jpg
texas-senate-2026/_staging/vision/out/sheet_*.jpg

# Bulk frame working sets: thousands of stills that only feed the committed
# contact sheets and the curated frame index. Regenerate with the pipeline.
texas-senate-2026/10_video_frames/keyframes/
texas-senate-2026/10_video_frames/context/

# Speech audio working set (64 kbps copies, ~2–3 GB) + per-cue timing files.
# Metrics, transcripts (.txt), plots and summary figures ARE tracked.
texas-senate-2026/11_speech_audio/audio/
texas-senate-2026/11_speech_audio/transcripts/*.cues.csv

# 16 kHz mono WAV cache used while measuring (~4 GB) — deleted after each run.
texas-senate-2026/_staging/vision/audio_cache/
texas-senate-2026/_staging/vision/*.log

# South Carolina video pipeline binaries (1.5 GB) and the 16 kHz WAV cache (2 GB).
# Both are regenerable; nothing in the deliverable depends on them.
south-carolina-senate-2026/_staging/vision/raw/
south-carolina-senate-2026/_staging/vision/models/
south-carolina-senate-2026/11_speech_audio/audio_cache/
south-carolina-senate-2026/_staging/_tmp_*
south-carolina-senate-2026/_staging/_tx_style.css

# Batch 2 (2026-11-18): full HTML copies of news pages are kept locally as the audit trail
# for quoted facts but are NOT committed — they are third-party publisher text and would add
# hundreds of MB. `_staging/fetch_log.csv` (committed) records every URL, status and file name.
michigan-senate-2026/_staging/mirrors/
alaska-senate-2026/_staging/mirrors/
iowa-senate-2026/_staging/mirrors/
ohio-senate-2026/_staging/mirrors/
georgia-senate-2026/_staging/mirrors/
los-angeles-mayor-2026/_staging/mirrors/

# One-off collection scratch (URL lists, parse dumps) from the batch-2 agents.
michigan-senate-2026/_staging/_work/
alaska-senate-2026/_staging/_work/
iowa-senate-2026/_staging/_work/
ohio-senate-2026/_staging/_work/
georgia-senate-2026/_staging/_work/
los-angeles-mayor-2026/_staging/_work/

# Raw search-hit dumps and temporary files from the batch-2 collection runs.
*/_staging/discovery/
*/_staging/_tmp_*
*/_staging/*.pyc



# Full fetched article text kept for quote verification during collection (third-party publisher text).
*/_staging/text/

# Batch-2 video pipeline binaries: source video (~2-4 GB) and shared ONNX weights.
